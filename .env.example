# Copie para .env.local e preencha. Nunca commite valores reais.
# Referência: docs/06-regras-dev.md §8. Na VPS, cada ambiente tem o seu /opt/codetomb/<ambiente>/.env.
# As próximas variáveis (login, arquivos, e-mail) entram com as issues que as usam.

# --- Ambiente ---
# development | staging | production (ausente = development)
APP_ENV=development

# --- Banco: uma conexão por role (valores locais do compose.dev.yaml, senhas fictícias) ---
# app_user: tabelas do produto, sempre com RLS
DATABASE_URL_APP=postgres://app_user:app_user_dev@127.0.0.1:55442/codetomb
# app_auth: só as tabelas de login
DATABASE_URL_AUTH=postgres://app_auth:app_auth_dev@127.0.0.1:55442/codetomb
# codetomb_owner: só as migrations
DATABASE_URL_OWNER=postgres://codetomb_owner:codetomb_owner_dev@127.0.0.1:55442/codetomb
