# Modelo do .env de UM ambiente na VPS (docs/08-infra-deploy.md). Na VPS:
#   /opt/codetomb/staging/.env e /opt/codetomb/production/.env, com `chmod 600` (só o usuário deploy lê).
# Nunca commite valores reais. Cada ambiente tem senhas próprias.
#
# Senhas: gere cada uma com `openssl rand -hex 32`. Só letras e números, porque as do banco entram
# nas URLs de conexão montadas pelo compose.yaml.

# --- Ambiente ---
# staging | production
APP_ENV=staging
# Endereço público do ambiente (base dos links de e-mail, a partir da M1)
SITE_URL=https://staging.codetomb.nbbrdev.com
# Porta local do app, alcançada só pelo Nginx: 3010 na produção, 3011 no staging
APP_PORT=3011

# --- Banco (Postgres do próprio ambiente) ---
# Porta do banco só dentro da VPS (127.0.0.1), para o backup pelo DBeaver via túnel SSH:
# 5442 na produção, 5443 no staging
DB_PORT=5443
# Superusuário: inicialização e backup pelo DBeaver. O app nunca o usa.
POSTGRES_PASSWORD=
# Roles do Codetomb (db/bootstrap/roles.sql), criadas na primeira subida do banco
CODETOMB_OWNER_PASSWORD=
APP_USER_PASSWORD=
APP_AUTH_PASSWORD=

# --- Somente no staging: senha do navegador (HTTP Basic Auth). Sem elas, o staging responde 503 ---
STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_PASSWORD=

# --- Somente na produção: lançamento (ADR-0008, NBB-106 E3-A) ---
# Sem esta linha (ou com outro valor), a produção mostra só a página "Em breve". No lançamento
# (v1.0.0), acrescente PUBLIC_LAUNCH=true e reinicie o app (deploy/README.md, "Lançamento").
# PUBLIC_LAUNCH=true
