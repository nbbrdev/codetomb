# Modelo do .env da produção na VPS (docs/08-infra-deploy.md). Na VPS:
#   /opt/codetomb/production/.env, com `chmod 600` (só o usuário deploy lê).
# Nunca commite valores reais. Não há staging (ADR-0010).
#
# Senhas: gere cada uma com `openssl rand -hex 32`. Só letras e números, porque as do banco entram
# nas URLs de conexão montadas pelo compose.yaml. Senhas diferentes das do Orçô.

# --- Ambiente ---
APP_ENV=production
# Endereço público (base dos links de e-mail, a partir da M1)
SITE_URL=https://codetomb.nbbrdev.com
# Porta local do app, alcançada só pelo Nginx
APP_PORT=3010

# --- Banco (Postgres da produção) ---
# Porta do banco só dentro da VPS (127.0.0.1), para o backup pelo DBeaver via túnel SSH
DB_PORT=5442
# Superusuário: inicialização e backup pelo DBeaver. O app nunca o usa.
POSTGRES_PASSWORD=
# Roles do Codetomb (db/bootstrap/roles.sql), criadas na primeira subida do banco
CODETOMB_OWNER_PASSWORD=
APP_USER_PASSWORD=
APP_AUTH_PASSWORD=

# --- Lançamento (ADR-0008, NBB-106 E3-A) ---
# Sem esta linha (ou com outro valor), a produção mostra só a página "Em breve". No lançamento
# (v1.0.0), acrescente PUBLIC_LAUNCH=true e recrie o app (deploy/README.md, "Lançamento").
# PUBLIC_LAUNCH=true
